# ==============================================================================
# NEXT PLC — Student Transfer Assistant (Google Cloud & Gemini Enterprise)
# Copy this file to `.env` and populate with your target Google Cloud project IDs.
# Never commit `.env` or hardcode project IDs in source code.
# ==============================================================================

# 1. Google Cloud & Vertex AI Runtime (Regional UK/London — europe-west2)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=europe-west2
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL_ID=gemini-2.5-flash

# 2. BigQuery Medallion Datasets & Dataplex AutoDQ (europe-west2)
BQ_STAGING_DATASET_ID=next_student_transfer_staging
BQ_GOLD_DATASET_ID=next_student_transfer_gold
DATAPLEX_SCAN_ID=next-student-transfer-dq-scan

# 3. Regional Model Armor (Day-1 Base State — europe-west2)
#    https://docs.cloud.google.com/model-armor/overview
#    https://docs.cloud.google.com/model-armor/data-residency
ENABLE_MODEL_ARMOR=1
MODEL_ARMOR_LOCATION=europe-west2
MODEL_ARMOR_API_ENDPOINT=https://modelarmor.europe-west2.rep.googleapis.com
MODEL_ARMOR_TEMPLATE_ID=next-student-transfer-armor

# 4. Cloud Run Services, Custom Domain Load Balancer & Cloud IAP
CLOUD_RUN_SERVICE_NAME=next-student-transfer-agent
PORTAL_SERVICE_NAME=next-portal-intake-app
PORTAL_CUSTOM_DOMAIN=next-portal.next-retail.example.com
DNS_PROJECT_ID=your-dns-project-id
DNS_ZONE_NAME=next-retail-zone
IAP_ADMIN_PRINCIPAL=hr-admin@next-retail.example.com
DEMO_EMAIL_BASE=hr-notifications@next-retail.example.com
DEMO_MODE=true

# 5. Gemini Enterprise Registration
GEMINI_ENTERPRISE_LOCATION=eu
GEMINI_ENTERPRISE_APP_ID=gemini-enterprise-retail-app

# 6. Enterprise IT Promotion Target (Used by IT_HANDOVER_BUNDLE/deploy_to_customer_ge.sh)
NEXT_IT_TARGET_PROJECT_ID=next-ge-poc
NEXT_IT_TARGET_REGION=europe-west2
NEP_STAGING_MODE=DO_NOT_POST_STAGE_1_HITL
