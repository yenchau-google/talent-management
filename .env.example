# ============================================================================
# NEXT Student Transfer Lighthouse — Environment Configuration (.env.example)
# Copy to .env (`cp .env.example .env`) and populate your Argolis values.
# NEVER commit .env or hardcode project IDs in Python/HTML source files.
# ============================================================================

# 1. Isolated Build & Live Demo Environment (CE Argolis Project)
ARGOLIS_PROJECT_ID=talent-management-513520
GOOGLE_CLOUD_PROJECT=talent-management-513520
ARGOLIS_PRINCIPAL=admin@yenchau.altostrat.com
GOOGLE_CLOUD_REGION=europe-west2
# Vertex AI Gemini endpoint location ('europe-west2' for regional UK residency or 'global')
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL_ID=gemini-2.5-flash

# 2. Day-1 Security Base State: Regional Model Armor (europe-west2 London)
# Docs: https://docs.cloud.google.com/model-armor/overview
# Regional endpoint: https://modelarmor.europe-west2.rep.googleapis.com
ENABLE_MODEL_ARMOR=1
MODEL_ARMOR_LOCATION=europe-west2
MODEL_ARMOR_API_ENDPOINT=https://modelarmor.europe-west2.rep.googleapis.com
MODEL_ARMOR_TEMPLATE_ID=next-student-transfer-armor

# 3. Cloud Run & Gemini Enterprise Registration (Argolis Demo App)
CLOUD_RUN_SERVICE_NAME=next-student-transfer-agent
GEMINI_ENTERPRISE_LOCATION=eu
GEMINI_ENTERPRISE_APP_ID=your-argolis-ge-app-id
BQ_STAGING_DATASET_ID=next_student_transfer_staging
BQ_GOLD_DATASET_ID=next_student_transfer_gold
DATAPLEX_SCAN_ID=next-student-transfer-dq-scan
DEMO_MODE=true
DEMO_EMAIL_BASE=admin@yenchau.altostrat.com

# 4. Target Customer Promotion Metadata (Used ONLY in IT_HANDOVER_BUNDLE/ docs, never deployed directly)
NEXT_IT_TARGET_PROJECT_ID=next-ge-poc
NEXT_IT_TARGET_REGION=europe-west2
